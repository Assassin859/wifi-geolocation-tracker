# Copy to server/.env
# Shared secret the ESP board sends in the X-Device-Key header (DASHBOARD_KEY in config.h).
DEVICE_API_KEY=change-me

# Default provider for tools/pc_geolocate.py: auto | windows | beacondb | google
GEO_PROVIDER=auto
# Only used by tools/pc_geolocate.py - the board has its own copy in config.h.
GOOGLE_API_KEY=

# Optional: show Google Maps on the dashboard instead of OpenStreetMap.
# Browser key with the "Maps JavaScript API" enabled, restricted by HTTP referrer.
# It is visible to anyone who opens the dashboard - do NOT reuse GOOGLE_API_KEY here.
GOOGLE_MAPS_JS_KEY=
# Optional map ID from Google Cloud > Map Management (defaults to DEMO_MAP_ID).
GOOGLE_MAPS_MAP_ID=

# Where the helper scripts send fixes.
DASHBOARD_BASE_URL=http://127.0.0.1:8000
